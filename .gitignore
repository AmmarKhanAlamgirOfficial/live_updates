# =========================
# Jekyll / Ruby
# =========================
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
# Ignore vendor directory if you install gems locally
vendor/

# =========================
# Node.js
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Ignore environment variables if you ever use them
.env

# =========================
# Debian 12 / Linux System Files
# =========================
# Temporary/backup files created by text editors
*~
*.swp
*.swo
# Trash folders and network file system logs
.Trash-*
.nfs*
.directory

# =========================
# macOS / Windows Trash (Recommended)
# =========================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/